---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Carpenter Meghann B"
  description="The page you're looking for doesn't exist."
>
  <section class="section-lg" style="min-height: 60vh; display: flex; align-items: center;">
    <div class="container-narrow text-center">
      <p class="eyebrow eyebrow-center">Error 404</p>
      <h1 style="font-size: var(--text-4xl); margin-bottom: var(--space-lg);">Looks like this page<br>got left on the cutting board.</h1>
      <p class="text-muted" style="font-size: var(--text-md); max-width: 44ch; margin-inline: auto; margin-bottom: var(--space-2xl);">
        The page you're looking for doesn't exist — maybe it moved, or it never made it out of the workshop. Either way, let's get you back to the good stuff.
      </p>
      <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary btn-lg">Back to Home</a>
        <a href="/portfolio" class="btn btn-outline btn-lg">View the Portfolio</a>
      </div>
    </div>
  </section>
</BaseLayout>
