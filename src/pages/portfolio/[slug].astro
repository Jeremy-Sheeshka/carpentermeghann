---
import { getCollection, render } from 'astro:content';
import PortfolioDetail from '../../components/PortfolioDetail.astro';
import { image } from '../../lib/images';

export async function getStaticPaths() {
  const projects = (await getCollection('portfolio')).sort(
    (a, b) => a.data.order - b.data.order
  );

  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      index: i + 1,
      total: projects.length,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { entry, index, total, prev, next } = Astro.props;
const { Content } = await render(entry);

function toDescription(body: string): string {
  return body
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`#>]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 155);
}
---

<PortfolioDetail
  title={entry.data.title}
  description={toDescription(entry.body ?? '')}
  hero={image(entry.data.hero)}
  images={entry.data.images.map(image)}
  index={index}
  total={total}
  prev={{ href: `/portfolio/${prev.id}`, label: prev.data.title }}
  next={{ href: `/portfolio/${next.id}`, label: next.data.title }}
>
  <Content />
</PortfolioDetail>
