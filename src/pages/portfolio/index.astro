---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { image } from '../../lib/images';

const projects = (await getCollection('portfolio')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Project Portfolio — Carpenter Meghann B"
  description="Browse a selection of my carpentry work. Each project reflects my commitment to quality craftsmanship and heartfelt care."
>
  <section class="service-hero">
    <Picture
      src={image('portfolio/misc/exteriordoortrimandsiding2.jpg')}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      alt=""
      loading="eager"
    />
    <div class="service-hero-content">
      <p class="eyebrow eyebrow-center">Selected work</p>
      <h1>Project Portfolio</h1>
      <p style="color: var(--fg-muted); font-size: var(--text-md); margin-top: var(--space-md);">Browse some selections of my work through the pictures below. <em>If you have any questions or would like to discuss your own project, feel free to <a href="/contact">reach out</a>.</em></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="bento">
        {projects.map((project, i) => (
          <a
            href={`/portfolio/${project.id}`}
            class:list={['bento-card', { 'bento-feature': i === 0 || i === 5 }]}
          >
            <Picture
              src={image(project.data.card)}
              widths={[480, 768, 1024, 1400]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              alt={project.data.title}
              loading="lazy"
            />
            <div class="bento-overlay">
              <span class="bento-index">{String(i + 1).padStart(2, '0')}</span>
              <h2>{project.data.title}</h2>
              <span class="bento-link">View gallery &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-accent">
    <div class="container-narrow text-center">
      <p class="eyebrow eyebrow-center">Your turn</p>
      <h2>Have a project in mind?</h2>
      <p class="text-muted" style="margin-top: var(--space-md); margin-bottom: var(--space-xl);">I'd love to hear about it. Let's discuss your vision and bring it to life.</p>
      <a href="/contact" class="btn btn-primary btn-lg">Get in Touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 260px;
    grid-auto-flow: dense;
    gap: var(--space-md);
  }

  .bento-card {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    display: block;
  }

  .bento-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .bento-card:hover :global(img) {
    transform: scale(1.05);
  }

  .bento-feature {
    grid-column: span 2;
    grid-row: span 2;
  }

  .bento-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-fluid-md);
    background: var(--scrim-card-bottom);
  }

  .bento-index {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-400);
    margin-bottom: var(--space-xs);
  }

  .bento-overlay h2 {
    font-size: var(--text-md);
    color: var(--fg);
    margin-bottom: var(--space-xs);
  }

  .bento-feature .bento-overlay h2 {
    font-size: var(--text-xl);
  }

  .bento-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    opacity: 0;
    transform: translateY(4px);
    transition: all var(--duration) var(--ease-out);
  }

  .bento-card:hover .bento-link {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 220px;
    }
  }

  @media (max-width: 560px) {
    .bento {
      grid-template-columns: 1fr;
      grid-auto-rows: 240px;
    }

    .bento-feature {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
